# =============================================================================
# CONSIDERAÇÃO TÉCNICA (doc §4): Utilizar controle de versão.
# Variáveis sensíveis nunca devem ser commitadas — apenas este exemplo.
# =============================================================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# PostgreSQL / Prisma
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://payment_user:payment_secret_change_me@localhost:15432/payment_db?schema=public
DB_HOST=localhost
DB_PORT=15432
DB_USERNAME=payment_user
DB_PASSWORD=payment_secret_change_me
DB_DATABASE=payment_db
DB_SSL=false

# Mercado Pago (https://www.mercadopago.com.br/developers)
# Use ACCESS_TOKEN de teste (TEST-...) em desenvolvimento
MERCADOPAGO_ACCESS_TOKEN=TEST-your-access-token-here
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret-here
# URL pública onde o Mercado Pago enviará notificações (ngrok em local)
MERCADOPAGO_NOTIFICATION_URL=https://your-public-url/api/webhooks/mercadopago
MERCADOPAGO_BACK_URL_SUCCESS=https://your-frontend/success
MERCADOPAGO_BACK_URL_FAILURE=https://your-frontend/failure
MERCADOPAGO_BACK_URL_PENDING=https://your-frontend/pending

# Temporal.io (opcional — doc §4)
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=payment-processing

# Security
API_KEY=dev-api-key-change-me
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
