# =============================================================================
# CONSIDERAÇÃO TÉCNICA (doc §4): Utilizar controle de versão.
# Variáveis sensíveis nunca devem ser commitadas — apenas este exemplo.
# =============================================================================

# Application
NODE_ENV=
PORT=
API_PREFIX=

# PostgreSQL / Prisma
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_SSL=

# Mercado Pago (https://www.mercadopago.com.br/developers)
# Use ACCESS_TOKEN de teste (TEST-...) em desenvolvimento
MERCADOPAGO_ACCESS_TOKEN=
# Obrigatória em production (assinatura secreta do painel Mercado Pago → Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública onde o Mercado Pago enviará notificações (ngrok em local)
MERCADOPAGO_NOTIFICATION_URL=
MERCADOPAGO_BACK_URL_SUCCESS=
MERCADOPAGO_BACK_URL_FAILURE=
MERCADOPAGO_BACK_URL_PENDING=

# Temporal.io (opcional — doc §4)
TEMPORAL_ENABLED=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_TASK_QUEUE=

# Security
API_KEY=
THROTTLE_TTL_MS=
THROTTLE_LIMIT=
CORS_ORIGINS=
# true apenas atrás de load balancer/proxy reverso (IP real no rate limit)
TRUST_PROXY=
