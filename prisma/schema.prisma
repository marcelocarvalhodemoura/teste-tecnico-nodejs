/**
 * =============================================================================
 * PRISMA SCHEMA (doc §2 / §5)
 * Modelo de dados do domínio de pagamento + índices para performance.
 * Clean Architecture: Prisma fica na infraestrutura; domínio permanece puro.
 * =============================================================================
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAIL
}

model Payment {
  id                   String        @id @db.Uuid
  cpf                  String        @db.Char(11)
  description          String        @db.VarChar(255)
  /// Valor em reais com 2 casas (evita float binário)
  amount               Decimal       @db.Decimal(12, 2)
  paymentMethod        PaymentMethod @map("payment_method")
  status               PaymentStatus
  externalId           String?       @unique @map("external_id") @db.VarChar(128)
  /// URL do checkout Mercado Pago (CREDIT_CARD) — disponível após criar a preferência
  checkoutUrl          String?       @map("checkout_url") @db.VarChar(2048)
  mercadoPagoPaymentId String?       @map("mercado_pago_payment_id") @db.VarChar(128)
  /// Idempotency-Key do cliente — UNIQUE para retries seguros
  idempotencyKey       String?       @unique @map("idempotency_key") @db.VarChar(128)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([cpf], map: "idx_payments_cpf")
  @@index([cpf, createdAt(sort: Desc)], map: "idx_payments_cpf_created")
  @@index([paymentMethod], map: "idx_payments_payment_method")
  @@index([status], map: "idx_payments_status")
  @@index([cpf, paymentMethod], map: "idx_payments_cpf_method")
  @@map("payments")
}
